---
import { ui } from '@/data/translations';

export interface Props {
  placeholder?: string;
  id?: string;
}

const { placeholder = ui.nav.search, id = 'search-input' } = Astro.props;
---

<div class="relative w-full">
  <svg
    class="absolute left-3 top-1/2 -translate-y-1/2 text-champ-muted pointer-events-none"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="11" cy="11" r="8" />
    <path d="m21 21-4.3-4.3" />
  </svg>
  <input
    type="search"
    id={id}
    placeholder={placeholder}
    class="input pl-10"
  />
</div>
