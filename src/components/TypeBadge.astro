---
import type { TypeId } from '@/data/types';
import { typeColors, typeIconUrl } from '@/data/types';
import { translateType } from '@/data/translations';

export interface Props {
  type: TypeId;
  size?: 'sm' | 'md' | 'lg';
  showBoth?: boolean;
  showIcon?: boolean;
}

const { type, size = 'md', showBoth = false, showIcon = true } = Astro.props;
const color = typeColors[type];
const thai = translateType(type);
const en = type.charAt(0).toUpperCase() + type.slice(1);

const sizeClass = {
  sm: 'text-[10px] pl-1 pr-2 py-0.5 gap-1',
  md: 'text-xs pl-1 pr-2.5 py-0.5 gap-1.5',
  lg: 'text-sm pl-1.5 pr-3.5 py-1 gap-2',
}[size];

const iconSize = {
  sm: 20,
  md: 24,
  lg: 32,
}[size];
---

<span
  class:list={['badge inline-flex items-center rounded-full uppercase tracking-wider font-bold', sizeClass]}
  style={`background-color: ${color}25; color: ${color}; border: 1px solid ${color}40;`}
  title={en}
>
  {showIcon && (
    <img
      src={typeIconUrl(type)}
      alt=""
      loading="lazy"
      width={iconSize}
      height={iconSize}
      class="object-contain flex-none"
      style={`width: ${iconSize}px; height: ${iconSize}px;`}
      onerror="this.style.display='none'"
    />
  )}
  {showBoth ? (
    <>
      <span>{thai}</span>
      <span class="opacity-60 normal-case font-normal">·</span>
      <span class="opacity-80">{en}</span>
    </>
  ) : (
    <span>{thai}</span>
  )}
</span>
