---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PokemonChip from '@/components/PokemonChip.astro';
import { TYPES, typeColors, typeInfo, getEffectiveness, typeIconUrl } from '@/data/types';
import type { TypeId } from '@/data/types';
import { ui, translateType } from '@/data/translations';

function getColor(mult: number) {
  if (mult === 0) return 'bg-champ-bg text-champ-muted border border-champ-border';
  if (mult === 0.5) return 'bg-red-500/15 text-red-300';
  if (mult === 1) return 'bg-champ-surface/40 text-champ-muted';
  if (mult === 2) return 'bg-green-500/20 text-green-300';
  return 'bg-champ-surface/40';
}

function getLabel(mult: number) {
  if (mult === 0) return '0';
  if (mult === 0.5) return '½';
  if (mult === 1) return '';
  if (mult === 2) return '2';
  return String(mult);
}
---

<BaseLayout title="ระบบธาตุ" description="ตารางความสัมพันธ์ระหว่าง 18 ธาตุของ Pokemon">
  <section class="container-page py-10">
    <div class="mb-8">
      <h1 class="font-display text-4xl tracking-wide mb-2">
        <span class="gradient-text">TYPE CHART</span>
        <span class="text-champ-muted text-base ml-3 font-sans normal-case">{ui.nav.types}</span>
      </h1>
      <p class="text-champ-muted">
        ระบบความสัมพันธ์ระหว่าง 18 ธาตุของ Pokémon — ใช้ใน Champions เหมือนเกมหลัก
        — Terastallization สามารถเปลี่ยนธาตุของโปเกมอนได้ในแมตช์
      </p>
    </div>

    <div class="card p-4 mb-6 flex gap-3 items-start text-sm">
      <span class="text-2xl flex-none">✦</span>
      <div>
        <div class="font-semibold text-champ-text mb-1">Tera Type ใน Pokémon Champions</div>
        <p class="text-champ-muted text-xs leading-relaxed">
          ผู้เล่นสามารถ Terastallize 1 ตัวต่อแมตช์เพื่อเปลี่ยนธาตุ (และเพิ่ม STAB) —
          แต่ใน Reg M-A จำกัด 1 กิมมิคต่อแมตช์ (เลือกใช้ Mega Evolution หรือ Tera อย่างใดอย่างหนึ่ง)
        </p>
      </div>
    </div>

    <!-- Legend -->
    <div class="card p-4 mb-6 flex flex-wrap gap-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="inline-flex w-7 h-7 bg-green-500/20 text-green-300 rounded items-center justify-center font-mono">2</span>
        <span>Super Effective (2×)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex w-7 h-7 bg-red-500/15 text-red-300 rounded items-center justify-center font-mono">½</span>
        <span>Not Very Effective (½×)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex w-7 h-7 bg-champ-bg text-champ-muted rounded items-center justify-center font-mono border border-champ-border">0</span>
        <span>No Effect (0×)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex w-7 h-7 bg-champ-surface/40 text-champ-muted rounded"></span>
        <span>Normal (1×)</span>
      </div>
    </div>

    <!-- Type Chart (equal-size cells via table-fixed) -->
    <div class="card p-2 overflow-x-auto">
      <table class="type-chart">
        <colgroup>
          <col class="header-col" />
          {TYPES.map(() => <col class="type-col" />)}
        </colgroup>
        <thead>
          <tr>
            <th class="sticky-corner">
              <div class="text-[9px] text-champ-muted uppercase leading-tight px-1">
                ATK ↓<br/>DEF →
              </div>
            </th>
            {TYPES.map((d) => (
              <th class="type-cell">
                <div
                  class="rounded-md flex flex-col items-center justify-center gap-0.5 py-1 px-0.5 h-full"
                  style={`background: ${typeColors[d]}30; border: 1px solid ${typeColors[d]}40;`}
                  title={d}
                >
                  <img
                    src={typeIconUrl(d)}
                    alt={d}
                    loading="lazy"
                    width="28"
                    height="28"
                    class="object-contain"
                    onerror="this.style.display='none'"
                  />
                  <span
                    class="text-[8px] font-bold uppercase tracking-wider leading-none"
                    style={`color: ${typeColors[d]}`}
                  >
                    {translateType(d)}
                  </span>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {TYPES.map((a: TypeId) => (
            <tr>
              <td class="sticky-corner">
                <div
                  class="rounded-md flex items-center gap-1.5 py-1.5 px-1.5 h-full"
                  style={`background: ${typeColors[a]}30; border: 1px solid ${typeColors[a]}40;`}
                >
                  <img
                    src={typeIconUrl(a)}
                    alt={a}
                    loading="lazy"
                    width="22"
                    height="22"
                    class="object-contain flex-none"
                    onerror="this.style.display='none'"
                  />
                  <span
                    class="text-[10px] font-bold uppercase tracking-wider leading-none truncate"
                    style={`color: ${typeColors[a]}`}
                  >
                    {translateType(a)}
                  </span>
                </div>
              </td>
              {TYPES.map((d: TypeId) => {
                const mult = getEffectiveness(a, d);
                return (
                  <td class="type-cell p-0.5">
                    <div
                      class:list={[
                        'rounded text-center font-mono font-bold text-sm flex items-center justify-center h-full w-full',
                        getColor(mult),
                      ]}
                      title={`${a} → ${d}: ${mult}×`}
                    >
                      {getLabel(mult)}
                    </div>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Type details with icons + Pokemon chips -->
    <div class="mt-12">
      <h2 class="font-display text-2xl tracking-wide mb-6">
        <span class="gradient-text">TYPE PROFILES</span>
        <span class="text-champ-muted text-sm font-sans normal-case ml-2">รายละเอียดแต่ละธาตุ</span>
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {TYPES.map((t) => {
          const info = typeInfo[t];
          return (
            <div
              class="card p-5 transition-all hover:-translate-y-1 hover:shadow-glow-gold"
              style={`border-left: 4px solid ${typeColors[t]}`}
            >
              <div class="flex items-center gap-3 mb-3">
                <span
                  class="flex-none rounded-lg flex items-center justify-center w-12 h-12"
                  style={`background: ${typeColors[t]}20; border: 1px solid ${typeColors[t]}40;`}
                >
                  <img
                    src={typeIconUrl(t)}
                    alt={t}
                    loading="lazy"
                    width="36"
                    height="36"
                    class="object-contain"
                    onerror="this.style.display='none'"
                  />
                </span>
                <div class="min-w-0">
                  <div class="font-display text-2xl tracking-wide uppercase leading-tight" style={`color: ${typeColors[t]}`}>
                    {translateType(t)}
                  </div>
                  <div class="text-[10px] text-champ-muted uppercase tracking-wider">{t}</div>
                </div>
              </div>
              <p class="text-sm text-champ-text leading-relaxed mb-4">{info.description}</p>
              <div>
                <div class="text-xs text-champ-muted uppercase tracking-wider mb-2">โปเกมอนเด่น</div>
                <div class="flex flex-col gap-1.5">
                  {info.signaturePokemon.map((p) => (
                    <PokemonChip name={p} />
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .type-chart {
    width: 100%;
    border-spacing: 2px;
    border-collapse: separate;
    table-layout: fixed;
  }
  .type-chart .header-col {
    width: 80px;
  }
  .type-chart .type-col {
    width: 56px;
  }
  .type-chart .type-cell {
    width: 56px;
    height: 56px;
    padding: 0;
    min-width: 56px;
  }
  .type-chart .sticky-corner {
    background: #13131a;
    padding: 2px;
    position: sticky;
    left: 0;
    z-index: 1;
    width: 80px;
    min-width: 80px;
    height: 56px;
  }
  .type-chart thead th.sticky-corner {
    z-index: 2;
  }
  .type-chart tbody td.sticky-corner {
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }
</style>
